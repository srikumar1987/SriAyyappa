# Google Drive Configuration
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
# sheets = use the Google Sheet; leave unset to use the local file during development
DATA_BACKEND=sheets
# Local development only: full path to the service account JSON key, kept OUTSIDE OneDrive and never committed
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\ayyappa-sheets-key.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=ayyappa-pooja-store@YOUR_PROJECT_ID.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# WhatsApp Configuration - store number with country code, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Translation API (Optional - MyMemory API is free)
TRANSLATION_API_KEY=optional_api_key

# Admin sign-in
# Admin username (defaults to admin if left out)
ADMIN_USERNAME=admin
# Create the hash with: node scripts/make_pin_hash.mjs "<password>"  (no $ in the value; the format uses :)
ADMIN_PASSWORD_HASH=pbkdf2:100000:salt:hash
# Any random text of 16+ characters, e.g. from a password manager
SESSION_SECRET=replace_with_a_long_random_string
